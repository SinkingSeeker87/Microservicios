# Copia este archivo a ".env" (mismo nombre, sin .example) y pega tu clave.
# El archivo .env NO se sube a git (está en .gitignore).

GEMINI_API_KEY=AIza...pega_tu_clave_aqui...

# Opcional: si el modelo por defecto (gemini-1.5-flash) está retirado,
# cambia aquí a uno vigente, p.ej. gemini-2.0-flash o gemini-flash-latest.
# GEMINI_MODEL=gemini-1.5-flash
